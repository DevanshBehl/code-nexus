{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "SESSION_COOKIE_SECRET",
    "BCRYPT_COST",
    "PASSWORD_MIN_LENGTH",
    "RABBITMQ_URL",
    "EXECUTION_ENGINE",
    "PISTON_URL",
    "JUDGE0_URL",
    "JUDGE0_API_KEY",
    "JUDGE0_API_HOST",
    "ARENA_QUEUE",
    "ARENA_CPU_TIME_LIMIT",
    "ARENA_MEMORY_LIMIT_KB",
    "ARENA_WALL_TIME_LIMIT",
    "ARENA_MAX_INFLIGHT",
    "ARENA_WORKER_PREFETCH",
    "WS_GATEWAY_PORT",
    "WS_GATEWAY_PUBLIC_URL",
    "RT_TOKEN_SECRET",
    "RT_TOKEN_TTL_SECONDS",
    "MEDIA_PROVIDER",
    "RTMP_INGEST_BASE",
    "HLS_PLAYBACK_BASE",
    "RTC_STUN_URLS",
    "RTC_TURN_URL",
    "RTC_TURN_USERNAME",
    "RTC_TURN_CREDENTIAL",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "S3_REGION",
    "RECORDING_STORAGE",
    "RECORDING_LOCAL_DIR",
    "RECORDING_MAX_CHUNK_BYTES",
    "RECORDING_MAX_TOTAL_BYTES",
    "RECORDING_RETENTION_DAYS",
    "RECORDING_URL_TTL_SECONDS"
  ],
  "globalDependencies": [".env", "tsconfig.base.json"],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "//": "12 persistent dev tasks (4 apps + 8 package watchers) need headroom above turbo's default cap of 10, or `pnpm dev` refuses to start.",
  "concurrency": "15"
}
