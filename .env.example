# =============================================================================
# Code Nexus — Environment Variables (Phase 1)
# =============================================================================
# Copy this file to `.env` and adjust values for your local machine.
#   cp .env.example .env
#
# ALL default credentials below are for LOCAL DEVELOPMENT ONLY.
# Never commit a real `.env`. Never use these values in staging/production.
# The api validates these at boot (zod) and fails fast if any is missing/invalid.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development

# ---- API (apps/api) ---------------------------------------------------------
# HTTP port the Express API listens on.
API_PORT=4000
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---- PostgreSQL (Prisma) ----------------------------------------------------
# Connection string used by Prisma. Matches docker-compose defaults.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://codenexus:codenexus_dev_pw@localhost:5432/codenexus?schema=public

# ---- Redis (REQUIRED from Phase 2 — backs sessions) -------------------------
REDIS_URL=redis://localhost:6379

# ---- Auth / sessions (Phase 2) ----------------------------------------------
# Secret used to SIGN the session cookie. MUST be >= 16 chars. Use a long random
# value in real environments (e.g. `openssl rand -base64 48`). Local-dev only:
SESSION_COOKIE_SECRET=dev-only-change-me-session-cookie-secret-00
# Session absolute lifetime and sliding idle timeout (seconds).
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=86400
# bcrypt cost factor (4–15) and minimum password length.
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=12
# Web origin(s) allowed to call the API cross-origin with credentials (comma-sep).
# Dev uses the Vite proxy (same-origin) so this only matters when served split.
WEB_ORIGIN=http://localhost:5173

# ---- RabbitMQ (Code Arena execution queue, Phase 6) -------------------------
RABBITMQ_URL=amqp://codenexus:codenexus_dev_pw@localhost:5672

# ---- Code Arena / execution engine (Phase 6) --------------------------------
# EXECUTION_ENGINE selects how the worker runs untrusted code:
#   'piston' — free public Piston API (no key, works on macOS)  [recommended]
#   'judge0' — Judge0 REST (self-hosted, or RapidAPI with a key)
EXECUTION_ENGINE=piston
PISTON_URL=https://emkc.org/api/v2/piston
# Judge0 (only when EXECUTION_ENGINE=judge0). For RapidAPI set all three:
#   JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#   JUDGE0_API_KEY=<your X-RapidAPI-Key>
#   JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
# Self-hosted (Linux VM / Colima): JUDGE0_URL=http://localhost:2358
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
# Execution limits + queue tuning (sane defaults; override only if needed).
ARENA_QUEUE=arena.submissions
ARENA_CPU_TIME_LIMIT=5
ARENA_MEMORY_LIMIT_KB=256000
ARENA_WALL_TIME_LIMIT=10
ARENA_MAX_INFLIGHT=3
ARENA_WORKER_PREFETCH=2

# ---- Webinars: real-time plane + media (Phase 8) ----------------------------
# The ws-gateway is a SEPARATE process from the api. The api mints short-lived RT
# tokens the gateway verifies with the SAME RT_TOKEN_SECRET (set a strong value
# in prod). WS_GATEWAY_PUBLIC_URL is the ws:// URL the browser connects to.
WS_GATEWAY_PORT=4100
WS_GATEWAY_PUBLIC_URL=ws://localhost:4100/ws
RT_TOKEN_SECRET=dev-rt-token-secret-change-me
RT_TOKEN_TTL_SECONDS=120
# Media plane (HLS, out of band). 'stub' = no media server (the room works, the
# player shows "stream not connected"); 'selfhosted' = an RTMP->HLS server the
# host pushes to (OBS) using the per-webinar stream key, viewers play the m3u8.
MEDIA_PROVIDER=stub
# Only used when MEDIA_PROVIDER=selfhosted (see the `media` docker-compose profile).
RTMP_INGEST_BASE=rtmp://localhost:1935
HLS_PLAYBACK_BASE=http://localhost:8888

# ---- Interviews: WebRTC ICE servers (Phase 9) -------------------------------
# Interview media is peer-to-peer (mesh); the api only hands out ICE servers.
# STUN (comma-separated) is always present — the default public STUN works on one
# network with no infra. TURN is OPTIONAL (set all three) for NAT traversal.
RTC_STUN_URLS=stun:stun.l.google.com:19302
RTC_TURN_URL=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# ---- MinIO / S3-compatible object storage (reserved — later phases) ---------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=codenexus
S3_SECRET_KEY=codenexus_dev_pw
S3_BUCKET=code-nexus-dev
S3_REGION=us-east-1

# ---- Web (apps/web) — Vite (must be VITE_ prefixed to reach the browser) -----
# Base URL the web app would call the API at (unused in Phase 1 — no API calls).
VITE_API_BASE_URL=http://localhost:4000

# ---- Interview recording (Phase 10) -----------------------------------------
# Storage is pluggable and works with NO extra infra by default:
#   local -> chunks written under RECORDING_LOCAL_DIR, streamed back by the api
#   s3    -> the S3_* settings above (MinIO in dev, AWS in prod — same code)
RECORDING_STORAGE=local
RECORDING_LOCAL_DIR=.data/recordings
RECORDING_MAX_CHUNK_BYTES=8388608
RECORDING_MAX_TOTAL_BYTES=2147483648
RECORDING_URL_TTL_SECONDS=3600
# 0 = keep recordings forever. Set a positive number of days to define a
# retention horizon (see SECURITY.md — recordings are personal data).
RECORDING_RETENTION_DAYS=0
